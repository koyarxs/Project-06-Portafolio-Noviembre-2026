# Solo desarrollo local. Copiar a .env y generar una contraseña propia.
COMPOSE_PROJECT_NAME=portfolio_noviembre_2026
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio_local
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_PORT=55432
# Mantener usuario, contraseña (codificada como URL), puerto y base sincronizados.
DATABASE_URL=postgresql://portfolio_local:replace_with_local_password@127.0.0.1:55432/portfolio?schema=public

# Backend: .env.<NODE_ENV> tiene prioridad sobre .env; variables del proceso prevalecen.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT=120
# En producción exigir orígenes HTTPS explícitos, separados por comas, sin barra final.

# Community: generate local secrets with npm run community:configure.
# Use the same signing/admin values in apps/web/.env.local. Never prefix NEXT_PUBLIC_.
# COMMUNITY_SIGNING_SECRET= (at least 48 characters; required for public production)
# COMMUNITY_ADMIN_TOKEN= (at least 48 random characters; absent = administration disabled)
COMMUNITY_REQUIRE_APPROVAL=false
# Absolute directory on a persistent filesystem; default: repository/.data/community
# COMMUNITY_UPLOAD_DIR=
