{
  "name": "@portfolio/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test test/components.test.tsx test/contracts.test.ts",
    "test:e2e": "playwright test",
    "cf:build": "opennextjs-cloudflare build && node scripts/worker-env.mjs",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:check": "node scripts/worker-env.mjs --check && opennextjs-cloudflare populateCache local && wrangler deploy --dry-run",
    "cf:deploy": "node scripts/worker-env.mjs --deploy && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "wrangler": "4.165.0"
  }
}
