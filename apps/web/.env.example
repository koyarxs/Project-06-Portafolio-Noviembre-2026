# Variables del servidor Next.js. No requieren prefijo NEXT_PUBLIC_.
# En Workers, configurar las variables y los secretos en el panel. Ver docs/cloudflare.md.
# Opcional: enlace Direct Chat Link de tu propiedad en tawk.to.
TAWK_DIRECT_CHAT_URL=
PORTFOLIO_API_URL=http://127.0.0.1:3001/api/v1
SITE_URL=http://127.0.0.1:3000
# Hosts HTTPS exactos aprobados para optimización de imágenes; sin comodines.
IMAGE_HOSTS=
# URLs exactas verificadas editorialmente antes de mostrar demos o despliegues.
VERIFIED_DEMO_URLS=
VERIFIED_DEPLOYMENT_URLS=

# Server-only community secrets, identical to the API environment.
# Generate development values with npm run community:configure at the repository root.
# COMMUNITY_SIGNING_SECRET=
# COMMUNITY_ADMIN_TOKEN=
